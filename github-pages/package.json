{
  "name": "axonx-github-pages",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "content": "node scripts/generate-content.mjs",
    "dev": "npm run content && vitepress dev .generated/site",
    "build": "npm run content && vitepress build .generated/site && node scripts/verify-build.mjs",
    "preview": "vitepress preview .generated/site",
    "format": "prettier --write . ../docs ../README.md ../README_ZH.md ../CONTRIBUTING.md ../CONTRIBUTING_ZH.md ../plugins/a158/README*.md ../plugins/a158_enhanced/README*.md --ignore-path ../.prettierignore",
    "format:check": "prettier --check . ../docs ../README.md ../README_ZH.md ../CONTRIBUTING.md ../CONTRIBUTING_ZH.md ../plugins/a158/README*.md ../plugins/a158_enhanced/README*.md --ignore-path ../.prettierignore"
  },
  "devDependencies": {
    "@vueuse/core": "^15.0.0",
    "prettier": "3.9.9",
    "vitepress": "1.6.4"
  },
  "overrides": {
    "vite": "^6.4.3"
  }
}
