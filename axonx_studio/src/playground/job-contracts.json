      "input_schema": {
        "type": "object",
        "properties": {
          "allow_missing": {
            "type": "boolean",
            "default": false,
            "description": "Return null when the requested file does not exist; invalid paths and other read failures remain errors."
          },
          "max_bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 33554432,
            "description": "Optional byte limit for text, Markdown, JSON and YAML previews; larger files return a marked prefix."
          },
          "path": {
            "type": "string",
            "description": "Workspace-relative path of the file to preview."
          },
          "offset": {
            "type": "integer",
            "minimum": 0,
            "default": 0,
            "description": "Number of rows to skip for row-based previews such as CSV."
          },
          "limit": {
