{
  "version": "0.3.1",
  "jobs": {
    "agent_chat": {
      "name": "agent_chat",
      "description": "Run one interactive Agent session turn over the workspace.",
      "input_schema": {
        "type": "object",
        "properties": {
          "message": {
            "type": "string",
            "minLength": 1,
            "description": "User message for this Agent turn."
          },
          "session_id": {
            "type": "string",
            "pattern": "^[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[1-8][0-9a-fA-F]{3}-[89aAbB][0-9a-fA-F]{3}-[0-9a-fA-F]{12}$",
            "description": "Existing Backend session UUID; omit to create a new Session."
          }
        },
        "required": ["message"],
        "additionalProperties": false
      },
      "output_schema": {
        "description": "Canonical result of a Job invocation across every transport.",
        "properties": {
          "answer": {
            "default": "",
            "description": "response content",
            "title": "Answer"
          },
          "success": {
            "default": true,
            "description": "whether succeeded",
            "title": "Success",
            "type": "boolean"
          },
          "metadata": {
            "additionalProperties": true,
            "description": "metadata",
            "title": "Metadata",
            "type": "object"
          }
        },
        "title": "JobResponse",
        "type": "object"
      }
    },
    "cancel_agent_turn": {
      "name": "cancel_agent_turn",
