# AxonX 0.3.0 environment configuration
# Copy to .env in your launch directory and fill in only the features you use.
# CLI searches the current directory and up to five parents for the nearest .env.
# Existing process environment values take precedence. Restart to reload changes.

# Local HTTP service; the README binds it to 127.0.0.1 on port 1024.
AXONX_SERVICE_TOKEN=your-service-token

# Bundled default/remote configuration interpolates these variables.
# AXONX_WORKSPACE_DIR=/absolute/path/to/workspace
# AXONX_SERVICE_WEB_ENABLED=true
# AXONX_SERVICE_SHUTDOWN_TIMEOUT=1
# AXONX_SERVICE_CLEANUP_TIMEOUT=15

# Optional: reachable service address advertised by Task workers for remote kill.
# An explicit port is required; loopback and wildcard hosts are rejected.
# AXONX_EXECUTION_TARGET=http://192.0.2.10:1024

# Optional: Claude-compatible built-in Agent backend.
# CLAUDE_CODE_API_KEY=your-api-key
# CLAUDE_CODE_BASE_URL=https://api.anthropic.com
# CLAUDE_CODE_MODEL_NAME=your-model-name

# Optional: Tushare data download (default endpoint shown).
# AXONX_TUSHARE_TOKEN=your-token
# AXONX_TUSHARE_BASE_URL=http://api.waditu.com/dataapi

# Optional: bundled remote configuration (axonx app --config remote).
# AXONX_TARGET populates that configuration's targets; CLI calls select --target.
# --target uses AXONX_TARGET_TOKEN; default local calls use AXONX_SERVICE_TOKEN.
# AXONX_TARGET=192.0.2.10:1024
# AXONX_TARGET_TOKEN=your-target-service-token

# Optional: uncomment the matching proxy/sync sections in a custom app config.
# AXONX_TUSHARE_PROXY_TIMEOUT=600
# AXONX_SYNC_TARGET=192.0.2.10:1024

# Optional: DingTalk application robot.
# DINGTALK_CLIENT_ID=your-client-id
# DINGTALK_CLIENT_SECRET=your-client-secret
# DINGTALK_CONVERSATIONS={"default":"your-open-conversation-id"}

# log_dir, timezone, bind_host and Task settings use YAML or explicit CLI options.
# Custom app configs must declare extends: default to inherit bundled defaults.
