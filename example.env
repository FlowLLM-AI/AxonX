# AxonX

# HTTP service and remote synchronization
AXONX_SERVICE_TOKEN=your-service-token
AXONX_REMOTE_HOST_IP=your-remote-ip
# AXONX_REMOTE_TOKEN=your-remote-service-token

# Claude Code agent backend (pip install 'axonx[agent]')
# ANTHROPIC_AUTH_TOKEN=your-api-key
# ANTHROPIC_BASE_URL=https://api.anthropic.com

# Tushare
AXONX_TUSHARE_TOKEN=your-token
AXONX_TUSHARE_BASE_URL=your-tushare-api-url

# DingTalk application robot
DINGTALK_CLIENT_ID=your-client-id
DINGTALK_CLIENT_SECRET=your-client-secret
DINGTALK_CONVERSATIONS={"default":"your-open-conversation-id"}
